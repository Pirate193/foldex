ACME_EMAIL=you@example.com

RESEND_API_KEY=re_your_key_here
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.foldex.space
FRONTEND_URL=https://foldex.space

